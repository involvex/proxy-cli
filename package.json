{
  "name": "@involvex/proxy-cli",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "author": "involvex",
  "repository": {
    "url": "https://github.com/involvex/proxy-cli.git",
    "type": "git"
  },
  "bin": {
    "proxy-cli": "dist/proxy-cli.js"
  },
  "scripts": {
    "build": "bun build --target node --minify ./src/index.ts --outfile dist/proxy-cli.js",
    "dev": "bun run src/index.ts",
    "format": "bun fmt",
    "typecheck": "bun check",
    "prebuild": "bun run verify",
    "verify": "bun fmt && bun check && bun lint --fix"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "proxy": "^4.1.0",
    "has-flag": "5.0.1"
  },
  "files": [
    "dist/proxy-cli.js",
    "README.md"
  ]
}
